{
  "name": "shoplogic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "node scripts/check-locales.mjs",
    "preview": "vite preview",
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run icon && npm run build && electron-builder --win --x64 --arm64"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "date-fns": "^3.6.0",
    "dexie": "^3.2.7",
    "dexie-react-hooks": "^1.1.7",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.shoplogic.pro",
    "productName": "ShopLogic Pro",
    "directories": {
      "output": "release"
    },    "files": ["dist/**", "electron/**"],
    "icon": "electron/icon.ico",
    "publish": [{ "provider": "github", "owner": "jimelyo", "repo": "shoplogic" }],
    "win": {
      "icon": "electron/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ShopLogic-Setup-${version}-${arch}.${ext}",
      "createDesktopShortcut": true,
      "shortcutName": "ShopLogic Pro"
    }
  }
}
